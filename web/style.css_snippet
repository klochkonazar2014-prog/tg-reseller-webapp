
/* --- PREMIUM FILTER LIST LAYOUT --- */
.filter-list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    transition: background 0.2s;
    width: 100%;
}

.filter-list-row:last-child {
    border-bottom: none;
}

.filter-list-row:active {
    background: rgba(255, 255, 255, 0.05);
}

.filter-left {
    display: flex;
    align-items: center;
    gap: 16px; 
}

.filter-icon-box {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 11px;
    color: #8b9bb4;
    text-transform: uppercase;
    flex-shrink: 0;
}

.filter-label {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    font-family: 'Outfit', sans-serif;
}

.filter-checkbox {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    position: relative;
    transition: all 0.2s;
    flex-shrink: 0;
}

.filter-list-row.selected .filter-checkbox {
    background: var(--accent-blue);
    border-color: var(--accent-blue);
}

.filter-list-row.selected .filter-checkbox::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%) rotate(45deg);
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
}

.filter-list-row.selected .filter-icon-box {
    border-color: var(--accent-blue);
    color: #fff;
    background: rgba(0, 136, 204, 0.1);
}
